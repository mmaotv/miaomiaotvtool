<?xml version="1.0" encoding="utf-8"?>
<!--
  应用图标：盒子（电视）造型 + 对勾，表示「设备已处理」。
  用单个 vector 绘制，底图与图形一起缩放，各尺寸下都不会变形。
  不使用渐变，保证安卓 5.1 等老设备也能正常渲染。
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 底板 -->
    <path
        android:fillColor="#FF00E0B0"
        android:pathData="M8,3 H40 A5,5 0 0 1 45,8 V40 A5,5 0 0 1 40,45 H8 A5,5 0 0 1 3,40 V8 A5,5 0 0 1 8,3 Z" />

    <!-- 屏幕 -->
    <path
        android:fillColor="#FF0F1519"
        android:pathData="M13,12 H35 A2,2 0 0 1 37,14 V30 A2,2 0 0 1 35,32 H13 A2,2 0 0 1 11,30 V14 A2,2 0 0 1 13,12 Z" />

    <!-- 底座 -->
    <path
        android:fillColor="#FF0F1519"
        android:pathData="M21,34 H27 V36 H21 Z M16,37 H32 A1,1 0 0 1 33,38 V39 A1,1 0 0 1 32,40 H16 A1,1 0 0 1 15,39 V38 A1,1 0 0 1 16,37 Z" />

    <!-- 对勾 -->
    <path
        android:fillColor="#00000000"
        android:pathData="M17,22 L22,27 L31,17.5"
        android:strokeWidth="3.4"
        android:strokeColor="#FF00E0B0"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />
</vector>
